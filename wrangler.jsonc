{
  // Kinga: static dashboard + one API route (/api/explain) that calls Workers AI
  "name": "kinga",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "routes": [{ "pattern": "kinga.kennedykorir.com", "custom_domain": true }]
}
